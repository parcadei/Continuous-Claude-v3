/* Agent Monitor TUI Stylesheet
 *
 * Industrial/utilitarian terminal aesthetic
 * Uses CSS variables for theme switching
 */

/* ============================================
 * Global Styles
 * ============================================ */

Screen {
    background: $background;
}

/* Header bar */
#header-bar {
    dock: top;
    height: 1;
    background: $surface;
    color: $primary;
    text-align: center;
    text-style: bold;
}

/* Footer with keybindings */
#footer-bar {
    dock: bottom;
    height: 1;
    background: $surface;
    color: $text-muted;
}

.keybind {
    color: $primary;
    text-style: bold;
}

/* ============================================
 * Tab Content
 * ============================================ */

TabbedContent {
    background: $background;
    height: 1fr;
}

TabPane {
    padding: 1;
    height: 100%;
}

ContentSwitcher {
    background: $background;
    height: 1fr;
}

/* Tab headers */
Tabs {
    background: $surface;
}

Tab {
    background: $surface;
    color: $text-muted;
    padding: 0 2;
}

Tab:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

Tab.-active {
    background: $primary;
    color: $background;
    text-style: bold;
}

/* ============================================
 * Common Widget Styles
 * ============================================ */

.section-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    padding: 0 1;
    border-bottom: solid $surface;
}

.empty-state {
    color: $text-muted;
    text-align: center;
    padding: 2;
    text-style: italic;
}

/* ============================================
 * Home Panel
 * ============================================ */

HomePanel {
    width: 100%;
    height: 100%;
}

HomePanel #header {
    text-align: center;
    color: $primary;
    margin-bottom: 1;
}

/* Metric cards */
MetricCard {
    width: 1fr;
    height: auto;
    border: tall $surface;
    padding: 1;
    margin: 0 1;
    background: $surface;
}

MetricCard .metric-label {
    color: $text-muted;
    text-style: italic;
}

MetricCard .metric-value {
    color: $primary;
    text-style: bold;
}

/* Resource gauges */
ResourceGauge {
    width: 1fr;
    height: auto;
    padding: 1;
    margin: 0 1;
}

ResourceGauge .gauge-label {
    color: $text;
    margin-bottom: 1;
}

ResourceGauge ProgressBar {
    width: 100%;
}

ProgressBar > .bar--bar {
    background: $surface;
}

ProgressBar > .bar--complete {
    background: $primary;
}

/* ============================================
 * Agent Panel
 * ============================================ */

AgentPanel {
    width: 100%;
    height: 100%;
}

AgentPanel .summary-row {
    height: auto;
    margin: 1 0;
    padding: 0 1;
    color: $text-muted;
}

AgentPanel .visualizer-container {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
    border: solid $surface;
    padding: 1;
}

/* Agent cards */
AgentCard {
    width: auto;
    min-width: 20;
    max-width: 30;
    height: auto;
    border: solid $surface;
    padding: 0 1;
    margin: 0 1 1 0;
    background: $surface;
}

AgentCard.running {
    border: solid $primary;
}

AgentCard.orphan {
    border: solid $error;
    background: $error 10%;
}

AgentCard .agent-header {
    text-style: bold;
}

AgentCard .agent-detail {
    color: $text-muted;
}

/* Pattern visualizers */
SwarmVisualizer,
HierarchicalVisualizer,
PipelineVisualizer,
JuryVisualizer,
GenericVisualizer {
    width: 100%;
    height: auto;
    padding: 1;
}

/* Responsive grid for agent cards */
GenericVisualizer #agent-grid,
SwarmVisualizer .swarm-grid {
    grid-size: 5;
    grid-gutter: 1;
    width: 100%;
    height: auto;
}

/* ============================================
 * Blackboard Panel
 * ============================================ */

BlackboardPanel {
    width: 100%;
    height: 100%;
}

BlackboardPanel .legend {
    color: $text-muted;
    padding: 0 1;
    margin-bottom: 1;
    border-bottom: solid $surface;
}

BlackboardPanel .summary-text {
    color: $text-muted;
    margin: 1 0;
    padding: 0 1;
}

BlackboardPanel .entries-container {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
    padding: 0 1;
}

/* Blackboard entries */
BlackboardEntry {
    width: 100%;
    height: auto;
    border: solid $surface;
    padding: 0 1;
    margin: 0 0 1 0;
    background: $surface;
}

BlackboardEntry.critical {
    border: solid $error;
    background: $error 10%;
}

BlackboardEntry.high {
    border: solid $warning;
}

BlackboardEntry .entry-header {
    text-style: bold;
}

BlackboardEntry .entry-content {
    color: $text;
    padding-left: 2;
}

BlackboardEntry .entry-meta {
    color: $text-muted;
    text-style: italic;
}

/* ============================================
 * Loading Indicator
 * ============================================ */

#loading-indicator {
    dock: top;
    height: 1;
    width: 100%;
    text-align: center;
    color: $warning;
    background: $surface;
}

.spinner {
    color: $primary;
}

/* ============================================
 * Notification Toast
 * ============================================ */

Toast {
    background: $surface;
    border: solid $primary;
    padding: 1 2;
}

Toast.-information {
    border: solid $primary;
}

Toast.-warning {
    border: solid $warning;
}

Toast.-error {
    border: solid $error;
}

/* ============================================
 * Settings Panel
 * ============================================ */

SettingsPanel {
    width: 100%;
    height: 100%;
}

SettingsPanel #header {
    text-align: center;
    color: $primary;
    margin-bottom: 1;
}

SettingsPanel .servers-row {
    height: auto;
    margin: 1 0;
}

SettingsPanel .config-section {
    margin-top: 2;
    padding: 1;
    border: tall $surface;
    background: $surface;
}

/* Server status cards */
ServerStatusCard {
    width: 1fr;
    height: auto;
    border: tall $surface;
    padding: 1;
    margin: 0 1;
    background: $surface;
}

ServerStatusCard .server-header {
    color: $text;
    text-style: bold;
}

ServerStatusCard .server-url {
    color: $text-muted;
}

ServerStatusCard .status-row {
    height: auto;
    margin-top: 1;
}

ServerStatusCard .health-indicator {
    width: 3;
}

ServerStatusCard .error-text {
    color: $error;
    text-style: italic;
    margin-top: 1;
}

ServerStatusCard .loading-text {
    color: $warning;
    margin-left: 1;
}

ServerStatusCard .button-row {
    height: auto;
    margin-top: 1;
}

ServerStatusCard Button {
    min-width: 10;
    margin-right: 1;
}

ServerStatusCard Button:disabled {
    opacity: 50%;
}
